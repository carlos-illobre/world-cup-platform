# ==========================================
# ENTORNO DE DESARROLLO LOCAL
# ==========================================

# Dominios
API_HOST=api.localhost
DASHBOARD_HOST=dashboard.localhost

# Email para sintaxis de Caddyfile (no contactará a Let's Encrypt para dominios .localhost)
ACME_EMAIL=dev@localhost

# Dashboard Build Target (Desarrollo usa la etapa 'development' y monta volumen local)
DASHBOARD_BUILD_TARGET=development
DASHBOARD_SRC_VOLUME=./dashboard

# Frontend API URL
VITE_INJURY_API_BASE_URL=https://api.localhost
