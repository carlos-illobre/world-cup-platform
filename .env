# Configuración de entorno para Docker Compose
# Copia este archivo a .env si quieres personalizar valores locales o de producción.

# ===== TRAEFIK =====
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_DASHBOARD_HOST=traefik.localhost

# ===== INJURY API =====
INJURY_API_HOST=0.0.0.0
INJURY_API_HOST_PORT=8000
INJURY_API_CONTAINER_PORT=8000
INJURY_API_HOST_INTERNAL=api.localhost
INJURY_API_URL=http://localhost:8000

# ===== DASHBOARD =====
DASHBOARD_HOST_PORT=3000
DASHBOARD_CONTAINER_PORT=3000
DASHBOARD_HOST_INTERNAL=dashboard.localhost
DASHBOARD_URL=http://localhost:3000

# Build / frontend
VITE_INJURY_API_BASE_URL=http://localhost:8000

# CORS permitidos para FastAPI
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://api.localhost,http://dashboard.localhost

# Modo de recarga del servidor de back-end
SERVER_RELOAD=false
