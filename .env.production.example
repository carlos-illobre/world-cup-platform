# Configuración de entorno para PRODUCCIÓN con Traefik + Let's Encrypt
# Copia este archivo a .env si despliegas en producción.
# Actualiza los valores según tu entorno.

# ===== TRAEFIK - PRODUCCIÓN =====
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
# Para producción, usa un dominio real (ej: dashboard.api.tudominio.com)
TRAEFIK_DASHBOARD_HOST=dashboard.api.tudominio.com

# Email para Let's Encrypt
TRAEFIK_ACME_EMAIL=admin@tudominio.com

# ===== INJURY API - PRODUCCIÓN =====
INJURY_API_HOST=0.0.0.0
INJURY_API_HOST_PORT=8000
INJURY_API_CONTAINER_PORT=8000
# Hostname interno para Traefik
INJURY_API_HOST_INTERNAL=api.tudominio.com
# URL pública de la API
INJURY_API_URL=https://api.tudominio.com

# ===== DASHBOARD - PRODUCCIÓN =====
DASHBOARD_HOST_PORT=3000
DASHBOARD_CONTAINER_PORT=3000
# Hostname interno para Traefik
DASHBOARD_HOST_INTERNAL=app.tudominio.com
# URL pública del dashboard
DASHBOARD_URL=https://app.tudominio.com

# Build / frontend
# En producción, el frontend llama a la API a través de Traefik
VITE_INJURY_API_BASE_URL=https://api.tudominio.com

# CORS permitidos para FastAPI en producción
CORS_ORIGINS=https://app.tudominio.com,https://api.tudominio.com

# Modo de recarga del servidor de back-end
SERVER_RELOAD=false
